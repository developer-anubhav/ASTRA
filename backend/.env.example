# ASTRA Backend Environment Configuration Template
# Copy this file to .env and adjust variables as needed for local development.

# Application Identity & Mode
APP_NAME="ASTRA Intelligence Engine"
APP_VERSION="0.2.0"
APP_ENV=development
DEBUG=true
DEMO_MODE=true

# Server Binding
API_HOST=0.0.0.0
API_PORT=8000
API_V1_PREFIX=/api/v1

# Security & CORS (Comma-separated URLs)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# PostgreSQL / PostGIS Connection String
# Leave empty or commented out to run in demonstration mode using in-memory datasets.
# Example for local PostgreSQL with PostGIS:
# DATABASE_URL=postgresql+asyncpg://astra_user:astra_password@localhost:5432/astra_db
DATABASE_URL=
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_TIMEOUT_SECONDS=5.0

# Logging
LOG_LEVEL=INFO
STRUCTURED_LOGGING=true

# CORTEX Reasoning Mode (demonstration | live)
CORTEX_REASONING_MODE=demonstration
